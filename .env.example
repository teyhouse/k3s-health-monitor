GROQ_API_KEY=your_groq_api_key_here
DISCORD_WEBHOOK=your_discord_webhook_url_here

# Velero backup monitoring. Set to false to disable the check (enabled by default).
VELERO_CHECK_ENABLED=true

# Cert-manager certificate monitoring. Set to false to disable (enabled by default).
CERT_CHECK_ENABLED=true

# Groq model used for the LLM analysis (default: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# How far back to scan for failed Velero backups, in hours (default: 24).
# VELERO_LOOKBACK_HOURS=24

# Warn on certificates expiring within this many days (default: 7).
# CERT_EXPIRY_WARNING_DAYS=7

# ExternalDNS resolution check. Set to false to disable the check (enabled by default).
EXTERNALDNS_CHECK_ENABLED=true

# Hostname to resolve, resolver to query, and IP the answer must match.
# EXTERNALDNS_CHECK_HOSTNAME=auth.fulda-cloud.com
# EXTERNALDNS_CHECK_RESOLVER=192.168.237.99
# EXTERNALDNS_CHECK_EXPECTED_IP=192.168.10.2
