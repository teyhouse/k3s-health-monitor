GROQ_API_KEY=your_groq_api_key_here
DISCORD_WEBHOOK=your_discord_webhook_url_here

# Velero backup monitoring. Set to false to disable the check (enabled by default).
VELERO_CHECK_ENABLED=true

# Cert-manager certificate monitoring. Set to false to disable (enabled by default).
CERT_CHECK_ENABLED=true

# Groq model used for the LLM analysis (default: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# How far back to scan for failed Velero backups, in hours (default: 24).
# VELERO_LOOKBACK_HOURS=24

# Warn on certificates expiring within this many days (default: 7).
# CERT_EXPIRY_WARNING_DAYS=7

# k3s API server certificate expiry check. Set to false to disable (enabled by default).
K3S_CERT_CHECK_ENABLED=true

# Warn when the k3s API server certificate expires within this many days (default: 30).
# K3S_CERT_WARNING_DAYS=30

# Node disk usage check (kubelet stats). Set to false to disable (enabled by default).
DISK_CHECK_ENABLED=true

# Warn when a node filesystem is at least this full, in percent (default: 80).
# DISK_USAGE_WARNING_PERCENT=80

# CloudNativePG cluster health and backup freshness. Set to false to disable (enabled by default).
CNPG_CHECK_ENABLED=true

# Flag CNPG clusters with a ScheduledBackup but no completed backup within this many hours (default: 24).
# CNPG_BACKUP_MAX_AGE_HOURS=24

# Flux reconciliation monitoring. Set to false to disable (enabled by default).
FLUX_CHECK_ENABLED=true

# SealedSecrets sync monitoring. Set to false to disable (enabled by default).
SEALED_SECRETS_CHECK_ENABLED=true

# ExternalDNS resolution check. Set to false to disable the check (enabled by default).
EXTERNALDNS_CHECK_ENABLED=true

# Hostname to resolve, resolver to query, and IP the answer must match.
# EXTERNALDNS_CHECK_HOSTNAME=auth.fulda-cloud.com
# EXTERNALDNS_CHECK_RESOLVER=192.168.237.99
# EXTERNALDNS_CHECK_EXPECTED_IP=192.168.10.2
